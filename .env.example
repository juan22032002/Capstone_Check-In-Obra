# Contraseñas de la base. Todas OBLIGATORIAS y sin valor por defecto; generar cada
# una con:  openssl rand -base64 36 | tr -d '+/=\n'
# scripts/levantar.sh las genera solas la primera vez.
#   POSTGRES_PASSWORD    superusuario "postgres": solo administración, la API no lo usa
#   DB_APP_PASSWORD      checkinobra_app: usuario de la API, solo DML
#   DB_MIGRADOR_PASSWORD checkinobra_migrador: dueño del esquema, solo lo usa Flyway
#   DB_PLATAFORMA_PASSWORD checkinobra_plataforma: lee y escribe la base de catálogo
POSTGRES_PASSWORD=CAMBIAR_generar_con_openssl_rand_base64_36
DB_APP_PASSWORD=CAMBIAR_generar_con_openssl_rand_base64_36
DB_MIGRADOR_PASSWORD=CAMBIAR_generar_con_openssl_rand_base64_36
DB_PLATAFORMA_PASSWORD=CAMBIAR_generar_con_openssl_rand_base64_36
# Opcional. checkinobra_aprovisionador: crea la base y el usuario de una empresa nueva (alta por API).
# Sin ella el alta de empresas por API no está disponible. Es una credencial con CREATEDB y CREATEROLE:
# guardarla solo donde corre la API.
DB_APROVISIONADOR_PASSWORD=

# Firma de los JWT. OBLIGATORIO: la API no arranca si falta, tiene menos de 32
# bytes o es este marcador. Generar uno propio:  openssl rand -base64 48
# (scripts/levantar.sh lo genera solo la primera vez). Si una instancia ya corrió
# con el valor por defecto antiguo, cambiarlo: los tokens firmados con él valían.
JWT_SECRET=CAMBIAR_generar_con_openssl_rand_base64_48

# Clave inicial del administrador (admin@arauco-ltda.cl), 8 o más caracteres. Sin ella
# nadie puede entrar como admin. La cuenta queda obligada a cambiarla en su primer
# ingreso, y reiniciar la API con la variable puesta no pisa la clave que elija.
# scripts/levantar.sh la genera sola la primera vez. Déjala vacía y define la tuya.
PRIMER_ADMIN_CLAVE=

# Primer operador de plataforma (el que da de alta empresas). Se crea al arrancar solo si el
# catálogo no tiene ninguno; la clave, de 12 a 72 caracteres. Sin ellas no hay acceso de plataforma.
PLATAFORMA_OPERADOR_EMAIL=
PLATAFORMA_OPERADOR_CLAVE=
