<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 y superior: ni el respaldo en la nube ni la transferencia a otro
     teléfono se llevan datos de la app. Las preferencias cifradas del token no
     se pueden restaurar en otro equipo de todas formas (la llave queda en el
     Keystore del teléfono original), así que copiarlas solo dejaría una sesión
     rota (hallazgo S-20). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
