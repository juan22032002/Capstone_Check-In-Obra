# Puerto 5433: es el que docker-compose publica en el host para PostgreSQL.
# Este archivo solo aplica si corres el backend FUERA de Docker (desde el IDE).
# Dentro de docker-compose la URL la inyecta el propio compose como db:5432.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/checkinobra
# Usuario de la API: checkinobra_app, solo DML. NO el superusuario. Sin valor por
# defecto en la API. Flyway usa otro (FLYWAY_USER, el migrador, dueño del esquema).
# Las contraseñas son las DB_APP_PASSWORD y DB_MIGRADOR_PASSWORD del .env de la raíz.
SPRING_DATASOURCE_USERNAME=checkinobra_app
SPRING_DATASOURCE_PASSWORD=CAMBIAR_copiar_DB_APP_PASSWORD_del_env_de_la_raiz
FLYWAY_USER=checkinobra_migrador
FLYWAY_PASSWORD=CAMBIAR_copiar_DB_MIGRADOR_PASSWORD_del_env_de_la_raiz
# Base de catálogo: qué empresas existen y cómo conectarse a cada una. Usuario
# checkinobra_plataforma; su contraseña es DB_PLATAFORMA_PASSWORD. Obligatorios.
CATALOGO_URL=jdbc:postgresql://localhost:5433/checkinobra_catalogo
CATALOGO_USER=checkinobra_plataforma
CATALOGO_PASSWORD=CAMBIAR_copiar_DB_PLATAFORMA_PASSWORD_del_env_de_la_raiz
# Obligatorio: la API no arranca si falta, tiene menos de 32 bytes o es el marcador.
# Generar uno propio: openssl rand -base64 48
JWT_SECRET=CAMBIAR_generar_con_openssl_rand_base64_48
